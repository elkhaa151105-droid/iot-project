/*
 * updateOLED()
 * ------------
 * Memperbarui seluruh tampilan pada layar OLED 128x64.
 * Layout terbagi menjadi:
 *   - Baris 0    : Header judul sistem
 *   - Garis 9    : Pemisah header
 *   - Baris 12   : Nilai BPM
 *   - Baris 24   : Nilai suhu tubuh
 *   - Baris 36   : Status gerakan
 *   - Garis 46   : Pemisah status
 *   - Baris 50   : Status kesehatan keseluruhan
 *
 * Setiap pemanggilan dimulai dengan clearDisplay() untuk
 * menghapus frame sebelumnya, lalu diakhiri display() untuk
 * menampilkan frame baru.
 */
void updateOLED() {
  display.clearDisplay(); // Hapus frame sebelumnya

  // ── Header ──────────────────────────────────────────────
  display.setTextSize(1);
  display.setCursor(10, 0);
  display.println("= HEALTHY MONITOR =");
  display.drawLine(0, 9, 127, 9, SSD1306_WHITE); // Garis pemisah

  // ── Detak Jantung ────────────────────────────────────────
  display.setCursor(0, 12);
  display.print("BPM  : ");
  if (fingerDetected && bpm > 0) {
    display.print((int)bpm);
    display.println(" bpm");
  } else {
    display.println("-- tempel jari");
  }

  // ── Suhu Tubuh ───────────────────────────────────────────
  display.setCursor(0, 24);
  display.print("Suhu : ");
  if (suhu > 0) {
    display.print(suhu, 1); // 1 angka desimal
    display.println(" C");
  } else {
    display.println("Sensor Error");
  }

  // ── Aktivitas Fisik ──────────────────────────────────────
  display.setCursor(0, 36);
  display.print("Gerak: ");
  display.println(totalAccel > ACCEL_THRESHOLD ? "Aktif" : "Tenang");

  // ── Status Kesehatan ─────────────────────────────────────
  display.drawLine(0, 46, 127, 46, SSD1306_WHITE); // Garis pemisah
  display.setCursor(0, 50);
  display.print("Status: ");
  display.println(statusKesehatan);

  display.display(); // Tampilkan semua ke layar
}


/*
 * tampilkanPesan()
 * ----------------
 * Menampilkan pesan dua baris pada OLED untuk keperluan
 * informasi sementara (inisialisasi, error, status koneksi).
 * Layar ditahan selama 1,5 detik sebelum kembali.
 *
 * Parameter:
 *   baris1 → teks baris pertama (judul)
 *   baris2 → teks baris kedua  (detail)
 */
void tampilkanPesan(String baris1, String baris2) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 20);
  display.println(baris1);
  display.setCursor(0, 35);
  display.println(baris2);
  display.display();
  delay(1500);
}


