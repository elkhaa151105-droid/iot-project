// ================================================================
//  BAGIAN 13 — SETUP (INISIALISASI SISTEM)
// ================================================================

void setup() {

  // ── Serial Monitor ─────────────────────────────────────────
  // Digunakan untuk debugging melalui Serial Monitor Arduino IDE
  Serial.begin(115200);
  Serial.println("\n[SISTEM] Memulai inisialisasi...");

  // ── Inisialisasi GPIO ──────────────────────────────────────
  // Set pin LED dan Buzzer sebagai output, lalu matikan keduanya
  pinMode(PIN_LED_MERAH, OUTPUT);
  pinMode(PIN_BUZZER,    OUTPUT);
  digitalWrite(PIN_LED_MERAH, LOW);
  digitalWrite(PIN_BUZZER,    LOW);

  // ── Inisialisasi OLED ──────────────────────────────────────
  // Jika OLED tidak ditemukan di alamat 0x3C, program berhenti
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("[ERROR] OLED tidak ditemukan di 0x3C!");
    while (true); // Berhenti jika OLED gagal
  }
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  tampilkanPesan("Healthy Monitor", "Memulai sistem...");
  Serial.println("[OK] OLED siap.");

  // ── Koneksi WiFi ───────────────────────────────────────────
  // Mencoba koneksi WiFi maksimal 20 kali (10 detik total).
  // Jika gagal, program tetap berjalan tanpa Telegram.
  Serial.print("[WiFi] Menghubungkan ke: ");
  Serial.println(WIFI_SSID);
  tampilkanPesan("Menghubungkan", "ke WiFi...");
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int wifiRetry = 0;
  while (WiFi.status() != WL_CONNECTED && wifiRetry < 20) {
    delay(500);
    Serial.print(".");
    wifiRetry++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n[WiFi] Terhubung!");
    Serial.println("[WiFi] IP: " + WiFi.localIP().toString());
    tampilkanPesan("WiFi Terhubung!", WiFi.localIP().toString());
  } else {
    Serial.println("\n[WiFi] GAGAL — periksa SSID/password.");
    tampilkanPesan("WiFi GAGAL", "Cek SSID/Password");
  }

  // Nonaktifkan verifikasi SSL agar Telegram dapat diakses.
  // Cukup aman untuk keperluan IoT non-kritis.
  client.setInsecure();

  // ── Inisialisasi MAX30102 ──────────────────────────────────
  // Sensor terhubung via I2C. setup() menggunakan konfigurasi
  // default SparkFun yang sudah dioptimalkan untuk deteksi BPM.
  // LED merah diaktifkan (IR untuk BPM), LED hijau dimatikan.
  if (!particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println("[ERROR] MAX30102 tidak ditemukan di I2C!");
    tampilkanPesan("ERROR:", "MAX30102 gagal");
    while (true);
  }
  particleSensor.setup();                     // Konfigurasi default
  particleSensor.setPulseAmplitudeRed(0x0A);  // LED merah dinyalakan redup
  particleSensor.setPulseAmplitudeGreen(0);   // LED hijau dimatikan
  Serial.println("[OK] MAX30102 siap.");

  // ── Inisialisasi DS18B20 ───────────────────────────────────
  // Modul DS18B20 dengan pull-up built-in. Cukup panggil begin().
  // Tidak perlu konfigurasi tambahan karena sudah menggunakan modul.
  sensorSuhu.begin();
  Serial.println("[OK] DS18B20 siap.");

  // ── Inisialisasi MPU6050 ───────────────────────────────────
  // Range akselerometer 8G → cukup untuk deteksi gerakan tubuh biasa.
  // Range giroskop 500°/s  → cukup untuk gerakan tangan normal.
  // Filter bandwidth 21Hz  → meredam noise frekuensi tinggi.
  if (!mpu.begin()) {
    Serial.println("[ERROR] MPU6050 tidak ditemukan di I2C!");
    tampilkanPesan("ERROR:", "MPU6050 gagal");
    while (true);
  }
  mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
  Serial.println("[OK] MPU6050 siap.");

  // ── Semua komponen siap ────────────────────────────────────
  delay(500);
  tampilkanPesan("Semua Siap!", "Tempel jari...");
  Serial.println("[SISTEM] Inisialisasi selesai. Sistem berjalan.\n");

  // ── Kirim notifikasi awal ke Telegram ─────────────────────
  // Memberitahu pengguna bahwa perangkat sudah aktif
  if (WiFi.status() == WL_CONNECTED) {
    String pesanAwal  = "🟢 *HEALTHY MONITOR AKTIF*\n";
    pesanAwal        += "━━━━━━━━━━━━━━━━━━━━\n";
    pesanAwal        += "Perangkat berhasil dinyalakan.\n";
    pesanAwal        += "Notifikasi otomatis akan dikirim\n";
    pesanAwal        += "jika terdeteksi kondisi abnormal.\n\n";
    pesanAwal        += "Ketik /bantuan untuk daftar perintah.";
    bot.sendMessage(CHAT_ID, pesanAwal, "Markdown");
  }
}


// ================================================================
//  BAGIAN 14 — LOOP UTAMA
// ================================================================

void loop() {
  unsigned long sekarang = millis(); // Ambil waktu saat ini

  // ── Baca MAX30102 (setiap saat / tanpa delay) ──────────────
  // MAX30102 perlu dibaca secepat mungkin agar algoritma
  // deteksi detak (checkForBeat) tidak melewatkan pulsa.
  bacaMAX30102();

  // ── Baca sensor lain setiap INTERVAL_SENSOR ───────────────
  // DS18B20 dan MPU6050 tidak perlu dibaca secepat MAX30102,
  // cukup setiap 2 detik untuk menghemat pemrosesan.
  if (sekarang - lastSensorTime >= INTERVAL_SENSOR) {
    lastSensorTime = sekarang;

    bacaDS18B20();          // Baca suhu tubuh
    bacaMPU6050();          // Baca akselerasi & gerakan
    tentukanStatus();       // Tentukan status kesehatan keseluruhan
    updateOLED();           // Perbarui tampilan OLED
    updateLEDdanBuzzer();   // Nyalakan/matikan LED & buzzer

    // Cetak data ke Serial Monitor untuk debugging
    Serial.printf(
      "[DATA] BPM: %.0f | Suhu: %.1f°C | Accel: %.2f m/s² | Status: %s\n",
      bpm, suhu, totalAccel, statusKesehatan.c_str()
    );
  }

  // ── Cek pesan Telegram masuk setiap INTERVAL_TELEGRAM ─────
  // Polling ke server Telegram untuk memeriksa perintah baru
  // dari pengguna (seperti /status, /bpm, dll).
  if (sekarang - lastTelegramCheck >= INTERVAL_TELEGRAM) {
    lastTelegramCheck = sekarang;
    if (WiFi.status() == WL_CONNECTED) {
      cekPesanTelegram();
    }
  }

  // ── Kirim notifikasi otomatis setiap INTERVAL_NOTIF ───────
  // Mengecek kondisi sensor secara berkala dan mengirim
  // peringatan jika ada kondisi abnormal yang belum dilaporkan.
  if (sekarang - lastNotifTime >= INTERVAL_NOTIF) {
    lastNotifTime = sekarang;
    if (WiFi.status() == WL_CONNECTED) {
      kirimNotifikasiOtomatis();
    }
  }
}


