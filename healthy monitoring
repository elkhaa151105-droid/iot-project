/*
 * bangunPesanStatus()
 * -------------------
 * Membangun string pesan status lengkap yang akan dikirim
 * ke Telegram. Format menggunakan Markdown Telegram:
 *   *teks*  = tebal
 *   _teks_  = miring
 *
 * Pesan mencakup:
 *   - Nilai BPM beserta status normalnya
 *   - Suhu tubuh beserta status normalnya
 *   - Data akselerasi dan status gerakan
 *   - Status kesehatan keseluruhan
 *   - Uptime perangkat
 *
 * Fungsi ini dipanggil saat pengguna mengirim /status
 * atau saat notifikasi otomatis dikirim.
 */
String bangunPesanStatus() {
  String msg = "📊 *STATUS KESEHATAN TERKINI*\n";
  msg += "━━━━━━━━━━━━━━━━━━━━\n";

  // ── Detak Jantung ──────────────────────────────────────
  msg += "❤️ *Detak Jantung* : ";
  if (fingerDetected && bpm > 0) {
    msg += String((int)bpm) + " bpm";
    if      (bpm < BPM_MIN) msg += " ⚠️ Bradikardia";
    else if (bpm > BPM_MAX) msg += " ⚠️ Takikardia";
    else                    msg += " ✅ Normal";
  } else {
    msg += "Jari tidak terdeteksi";
  }
  msg += "\n";

  // ── Suhu Tubuh ─────────────────────────────────────────
  msg += "🌡️ *Suhu Tubuh*    : ";
  if (suhu > 0) {
    msg += String(suhu, 1) + " °C";
    if      (suhu > SUHU_MAX)             msg += " 🔴 Demam";
    else if (suhu < SUHU_MIN && suhu > 0) msg += " 🔵 Hipotermia";
    else                                  msg += " ✅ Normal";
  } else {
    msg += "Sensor Error";
  }
  msg += "\n";

  // ── Akselerasi & Gerakan ───────────────────────────────
  msg += "🏃 *Aktivitas*     : ";
  msg += statusGerakan;
  msg += " (" + String(totalAccel, 2) + " m/s²)\n";

  // ── Status Keseluruhan ─────────────────────────────────
  msg += "━━━━━━━━━━━━━━━━━━━━\n";
  msg += "📋 *Status*  : " + statusKesehatan + "\n";
  msg += "🕐 *Uptime*  : " + String(millis() / 1000) + " detik";

  return msg;
}


/*
 * kirimNotifikasiOtomatis()
 * -------------------------
 * Mengecek kondisi sensor secara berkala dan mengirimkan
 * notifikasi peringatan ke Telegram jika ditemukan kondisi
 * abnormal yang BELUM dilaporkan (dicek via flag notif).
 *
 * Kondisi yang memicu notifikasi:
 *   1. BPM < BPM_MIN           → Bradikardia
 *   2. BPM > BPM_MAX           → Takikardia
 *   3. Suhu > SUHU_MAX         → Demam
 *   4. Suhu < SUHU_MIN         → Hipotermia
 *   5. Accel > ACCEL_INTENSE   → Gerakan sangat intens
 *
 * Setiap notifikasi hanya dikirim SEKALI per kejadian
 * menggunakan flag boolean. Flag di-reset saat kondisi
 * kembali normal (di tentukanStatus() atau bacaMAX30102()).
 */
void kirimNotifikasiOtomatis() {

  // ── Notifikasi Bradikardia ─────────────────────────────
  if (fingerDetected && bpm > 0 && bpm < BPM_MIN && !notifBPMTerkirim) {
    String msg  = "🚨 *PERINGATAN DETAK JANTUNG*\n";
    msg += "━━━━━━━━━━━━━━━━━━━━\n";
    msg += "Detak jantung terlalu *rendah*!\n";
    msg += "BPM Terdeteksi : *" + String((int)bpm) + " bpm*\n";
    msg += "Kondisi        : Bradikardia\n";
    msg += "Batas normal   : " + String(BPM_MIN) + "–" + String(BPM_MAX) + " bpm\n\n";
    msg += "Segera periksa kondisi Anda!";
    bot.sendMessage(CHAT_ID, msg, "Markdown");
    notifBPMTerkirim = true;
    Serial.println("[TELEGRAM] Notif bradikardia terkirim.");
  }

  // ── Notifikasi Takikardia ──────────────────────────────
  if (fingerDetected && bpm > BPM_MAX && !notifBPMTerkirim) {
    String msg  = "🚨 *PERINGATAN DETAK JANTUNG*\n";
    msg += "━━━━━━━━━━━━━━━━━━━━\n";
    msg += "Detak jantung terlalu *tinggi*!\n";
    msg += "BPM Terdeteksi : *" + String((int)bpm) + " bpm*\n";
    msg += "Kondisi        : Takikardia\n";
    msg += "Batas normal   : " + String(BPM_MIN) + "–" + String(BPM_MAX) + " bpm\n\n";
    msg += "Cobalah beristirahat sejenak.";
    bot.sendMessage(CHAT_ID, msg, "Markdown");
    notifBPMTerkirim = true;
    Serial.println("[TELEGRAM] Notif takikardia terkirim.");
  }

  // ── Notifikasi Demam ───────────────────────────────────
  if (suhu > SUHU_MAX && !notifSuhuTerkirim) {
    String msg  = "🌡️ *PERINGATAN SUHU TUBUH*\n";
    msg += "━━━━━━━━━━━━━━━━━━━━\n";
    msg += "Suhu tubuh terdeteksi *tinggi*!\n";
    msg += "Suhu Terdeteksi : *" + String(suhu, 1) + " °C*\n";
    msg += "Kondisi         : Demam\n";
    msg += "Batas normal    : " + String(SUHU_MIN, 1) + "–" + String(SUHU_MAX, 1) + " °C\n\n";
    msg += "Istirahatlah dan minum air yang cukup.";
    bot.sendMessage(CHAT_ID, msg, "Markdown");
    notifSuhuTerkirim = true;
    Serial.println("[TELEGRAM] Notif demam terkirim.");
  }

  // ── Notifikasi Hipotermia ──────────────────────────────
  if (suhu > 0 && suhu < SUHU_MIN && !notifSuhuTerkirim) {
    String msg  = "🌡️ *PERINGATAN SUHU TUBUH*\n";
    msg += "━━━━━━━━━━━━━━━━━━━━\n";
    msg += "Suhu tubuh terdeteksi *rendah*!\n";
    msg += "Suhu Terdeteksi : *" + String(suhu, 1) + " °C*\n";
    msg += "Kondisi         : Hipotermia\n";
    msg += "Batas normal    : " + String(SUHU_MIN, 1) + "–" + String(SUHU_MAX, 1) + " °C\n\n";
    msg += "Segera hangatkan tubuh Anda!";
    bot.sendMessage(CHAT_ID, msg, "Markdown");
    notifSuhuTerkirim = true;
    Serial.println("[TELEGRAM] Notif hipotermia terkirim.");
  }

  // ── Notifikasi Gerakan Intens ──────────────────────────
  if (totalAccel > ACCEL_INTENSE && !notifGerakTerkirim) {
    String msg  = "🏃 *PERINGATAN AKTIVITAS*\n";
    msg += "━━━━━━━━━━━━━━━━━━━━\n";
    msg += "Terdeteksi gerakan yang *sangat intens*!\n";
    msg += "Akselerasi : *" + String(totalAccel, 2) + " m/s²*\n\n";
    msg += "Pastikan kondisi pengguna dalam keadaan aman.";
    bot.sendMessage(CHAT_ID, msg, "Markdown");
    notifGerakTerkirim = true;
    Serial.println("[TELEGRAM] Notif gerakan intens terkirim.");
  }
}


/*
 * cekPesanTelegram()
 * ------------------
 * Melakukan polling ke server Telegram untuk mengambil
 * pesan/perintah terbaru dari pengguna. Setiap pesan diproses
 * berdasarkan teks perintah yang diterima.
 *
 * Daftar perintah yang didukung:
 *   /start   → Sama dengan /bantuan, tampilkan menu
 *   /bantuan → Tampilkan semua perintah yang tersedia
 *   /status  → Kirim data kesehatan lengkap saat ini
 *   /bpm     → Kirim data detak jantung saja
 *   /suhu    → Kirim data suhu tubuh saja
 *   /gerakan → Kirim data akselerasi dan aktivitas
 *   /info    → Kirim info perangkat (IP, uptime, sensor)
 *
 * Perintah tidak dikenal akan dibalas dengan pesan error
 * dan saran untuk mengetik /bantuan.
 *
 * Semua teks perintah dikonversi ke huruf kecil (toLowerCase)
 * agar tidak case-sensitive.
 */
void cekPesanTelegram() {
  int jumlahPesan = bot.getUpdates(bot.last_message_received + 1);

  while (jumlahPesan > 0) {
    for (int i = 0; i < jumlahPesan; i++) {
      String chat_id = bot.messages[i].chat_id; // ID pengirim pesan
      String teks    = bot.messages[i].text;    // Isi pesan
      teks.toLowerCase(); // Normalisasi ke huruf kecil

      Serial.println("[TELEGRAM] Pesan masuk: " + teks + " dari " + chat_id);

      // ── /status ───────────────────────────────────────
      // Mengirimkan semua data kesehatan sekaligus
      if (teks == "/status") {
        bot.sendMessage(chat_id, bangunPesanStatus(), "Markdown");
      }

      // ── /bpm ──────────────────────────────────────────
      // Mengirimkan data detak jantung saja
      else if (teks == "/bpm") {
        String msg = "❤️ *Detak Jantung*\n";
        msg += "━━━━━━━━━━━━━━━━━━━━\n";
        if (fingerDetected && bpm > 0) {
          msg += "BPM    : *" + String((int)bpm) + " bpm*\n";
          if      (bpm < BPM_MIN) msg += "Status : ⚠️ Bradikardia (< " + String(BPM_MIN) + " bpm)";
          else if (bpm > BPM_MAX) msg += "Status : ⚠️ Takikardia  (> " + String(BPM_MAX) + " bpm)";
          else                    msg += "Status : ✅ Normal";
        } else {
          msg += "Jari tidak terdeteksi.\n";
          msg += "Tempelkan jari pada sensor MAX30102.";
        }
        bot.sendMessage(chat_id, msg, "Markdown");
      }

      // ── /suhu ─────────────────────────────────────────
      // Mengirimkan data suhu tubuh saja
      else if (teks == "/suhu") {
        String msg = "🌡️ *Suhu Tubuh*\n";
        msg += "━━━━━━━━━━━━━━━━━━━━\n";
        if (suhu > 0) {
          msg += "Suhu   : *" + String(suhu, 1) + " °C*\n";
          if      (suhu > SUHU_MAX)             msg += "Status : 🔴 Demam       (> " + String(SUHU_MAX, 1) + " °C)";
          else if (suhu < SUHU_MIN && suhu > 0) msg += "Status : 🔵 Hipotermia  (< " + String(SUHU_MIN, 1) + " °C)";
          else                                  msg += "Status : ✅ Normal";
        } else {
          msg += "Sensor DS18B20 tidak terbaca.\n";
          msg += "Periksa koneksi kabel sensor.";
        }
        bot.sendMessage(chat_id, msg, "Markdown");
      }

      // ── /gerakan ──────────────────────────────────────
      // Mengirimkan data akselerasi 3-axis dan status gerakan
      else if (teks == "/gerakan") {
        String msg = "🏃 *Aktivitas Fisik*\n";
        msg += "━━━━━━━━━━━━━━━━━━━━\n";
        msg += "Accel X : " + String(accelX, 2) + " m/s²\n";
        msg += "Accel Y : " + String(accelY, 2) + " m/s²\n";
        msg += "Accel Z : " + String(accelZ, 2) + " m/s²\n";
        msg += "Total   : *" + String(totalAccel, 2) + " m/s²*\n";
        msg += "Status  : " + statusGerakan;
        bot.sendMessage(chat_id, msg, "Markdown");
      }

      // ── /info ─────────────────────────────────────────
      // Mengirimkan informasi teknis perangkat
      else if (teks == "/info") {
        String msg = "ℹ️ *Info Perangkat*\n";
        msg += "━━━━━━━━━━━━━━━━━━━━\n";
        msg += "Nama    : Mental Health IoT Device\n";
        msg += "MCU     : ESP32\n";
        msg += "Sensor  : MAX30102 | DS18B20 | MPU6050\n";
        msg += "Output  : OLED | LED | Buzzer | Telegram\n";
        msg += "IP      : " + WiFi.localIP().toString() + "\n";
        msg += "WiFi    : " + String(WIFI_SSID) + "\n";
        msg += "Uptime  : " + String(millis() / 1000) + " detik";
        bot.sendMessage(chat_id, msg, "Markdown");
      }

      // ── /bantuan & /start ──────────────────────────────
      // Menampilkan daftar semua perintah yang tersedia
      else if (teks == "/bantuan" || teks == "/start") {
        String msg = "🤖 *Healthy Monitoring Bot*\n";
        msg += "━━━━━━━━━━━━━━━━━━━━\n";
        msg += "Daftar perintah:\n\n";
        msg += "📊 /status   — Semua data kesehatan\n";
        msg += "❤️ /bpm      — Detak jantung\n";
        msg += "🌡️ /suhu     — Suhu tubuh\n";
        msg += "🏃 /gerakan  — Aktivitas fisik\n";
        msg += "ℹ️ /info     — Info perangkat\n";
        msg += "🆘 /bantuan  — Menu ini\n";
        msg += "━━━━━━━━━━━━━━━━━━━━\n";
        msg += "Notifikasi otomatis aktif untuk\n";
        msg += "kondisi Bradikardia, Takikardia,\n";
        msg += "Demam, Hipotermia & gerakan intens.";
        bot.sendMessage(chat_id, msg, "Markdown");
      }

      // ── Perintah tidak dikenal ─────────────────────────
      else {
        String msg = "❓ Perintah tidak dikenali.\n";
        msg += "Ketik /bantuan untuk melihat\n";
        msg += "daftar perintah yang tersedia.";
        bot.sendMessage(chat_id, msg, "");
      }
    }
    // Ambil update berikutnya jika ada
    jumlahPesan = bot.getUpdates(bot.last_message_received + 1);
  }
}
