//  BAGIAN 15 — FUNGSI BACA SENSOR
// ================================================================

/*
 * bacaMAX30102()
 * --------------
 * Membaca nilai inframerah (IR) dari sensor MAX30102 untuk
 * mendeteksi denyut jantung menggunakan algoritma PPG
 * (Photoplethysmography) dari library SparkFun.
 *
 * Cara kerja:
 * 1. Ambil nilai IR dari sensor
 * 2. Cek apakah jari menempel (nilai IR > 50000)
 * 3. Jika ada detak terdeteksi (checkForBeat), hitung BPM instan
 * 4. Simpan ke array rates[] dan hitung rata-rata (beatAvg)
 * 5. Nilai bpm di-update dari beatAvg
 *
 * Catatan: Fungsi ini dipanggil di setiap iterasi loop() tanpa
 * delay agar tidak ada detak yang terlewat.
 */
void bacaMAX30102() {
  long irValue = particleSensor.getIR(); // Baca nilai sensor IR

  // Jari dianggap menempel jika nilai IR di atas 50000
  fingerDetected = (irValue > 50000);

  if (fingerDetected) {
    // checkForBeat() mendeteksi puncak sinyal PPG
    // dan mengembalikan true saat detak terdeteksi
    if (checkForBeat(irValue)) {
      long delta   = millis() - lastBeat; // Interval antar detak (ms)
      lastBeat     = millis();
      beatsPerMinute = 60.0 / (delta / 1000.0); // Konversi ke BPM

      // Filter nilai BPM yang tidak wajar
      if (beatsPerMinute > 20 && beatsPerMinute < 255) {
        rates[rateSpot++] = (byte)beatsPerMinute;
        rateSpot %= RATE_SIZE; // Kembali ke indeks 0 setelah penuh

        // Hitung rata-rata dari 4 sampel terakhir
        beatAvg = 0;
        for (byte x = 0; x < RATE_SIZE; x++) {
          beatAvg += rates[x];
        }
        beatAvg /= RATE_SIZE;
      }
    }
    bpm = beatAvg; // Update nilai BPM global

  } else {
    // Jari tidak menempel — reset semua nilai BPM
    bpm     = 0;
    beatAvg = 0;
    notifBPMTerkirim = false; // Reset flag agar notif bisa dikirim lagi nanti
  }
}


/*
 * bacaDS18B20()
 * -------------
 * Meminta konversi suhu dari sensor DS18B20 dan membaca hasilnya
 * dalam satuan Celcius.
 *
 * Catatan: Karena menggunakan MODUL DS18B20 (bukan sensor bare),
 * resistor pull-up sudah ada di PCB sehingga tidak perlu
 * tambahan resistor eksternal. Fungsi ini memanggil
 * requestTemperatures() terlebih dahulu sebelum getTempCByIndex().
 *
 * Jika sensor tidak terbaca (DEVICE_DISCONNECTED_C = -127),
 * nilai suhu disetel ke -1 sebagai tanda error.
 */
void bacaDS18B20() {
  sensorSuhu.requestTemperatures(); // Kirim perintah konversi ke sensor
  float temp = sensorSuhu.getTempCByIndex(0); // Baca suhu sensor pertama

  if (temp != DEVICE_DISCONNECTED_C) {
    suhu = temp; // Suhu valid, simpan ke variabel global
  } else {
    suhu = -1;   // Sensor error atau tidak terhubung
    Serial.println("[WARN] DS18B20 tidak terbaca — periksa koneksi.");
  }
}


/*
 * bacaMPU6050()
 * -------------
 * Membaca data akselerasi 3-axis (X, Y, Z) dari sensor MPU6050.
 * Kemudian menghitung magnitudo total akselerasi dan mengurangi
 * nilai gravitasi (~9.8 m/s²) agar hasilnya merepresentasikan
 * gerakan murni (bukan pengaruh gravitasi bumi).
 *
 * Rumus: totalAccel = sqrt(X² + Y² + Z²) - 9.8
 *
 * Jika totalAccel > ACCEL_THRESHOLD  → pengguna bergerak aktif
 * Jika totalAccel > ACCEL_INTENSE    → gerakan sangat intens
 *
 * Flag notifGerakTerkirim di-reset ketika pengguna kembali tenang.
 */
void bacaMPU6050() {
  sensors_event_t a, g, temp_mpu;
  mpu.getEvent(&a, &g, &temp_mpu); // Ambil data event akselerasi, giroskop, suhu

  accelX = a.acceleration.x;
  accelY = a.acceleration.y;
  accelZ = a.acceleration.z;

  // Hitung magnitudo total dan kurangi gravitasi
  totalAccel = sqrt(accelX * accelX + accelY * accelY + accelZ * accelZ) - 9.8;
  if (totalAccel < 0) totalAccel = 0; // Pastikan tidak negatif

  if (totalAccel > ACCEL_THRESHOLD) {
    statusGerakan = "Aktif Bergerak";
  } else {
    statusGerakan = "Tenang";
    notifGerakTerkirim = false; // Reset flag saat pengguna kembali tenang
  }
}


