/*
 * tentukanStatus()
 * ----------------
 * Menentukan status kesehatan keseluruhan berdasarkan data
 * dari ketiga sensor. Prioritas pengecekan:
 *   1. Jari tidak terdeteksi → minta tempel jari
 *   2. BPM terlalu rendah    → Bradikardia
 *   3. BPM terlalu tinggi    → Takikardia
 *   4. Suhu terlalu tinggi   → Demam
 *   5. Suhu terlalu rendah   → Hipotermia
 *   6. Gerakan aktif         → Aktif Bergerak
 *   7. Semua normal          → Normal (reset semua flag notif)
 */
void tentukanStatus() {

  // Jari tidak menempel — tidak ada data BPM yang valid
  if (!fingerDetected || bpm == 0) {
    statusKesehatan = "Tempel Jari";
    return;
  }

  if (bpm < BPM_MIN) {
    statusKesehatan = "Bradikardia";       // Detak jantung terlalu lambat
  } else if (bpm > BPM_MAX) {
    statusKesehatan = "Takikardia";        // Detak jantung terlalu cepat
  } else if (suhu > SUHU_MAX) {
    statusKesehatan = "Demam";             // Suhu tubuh di atas normal
  } else if (suhu < SUHU_MIN && suhu > 0) {
    statusKesehatan = "Hipotermia";        // Suhu tubuh di bawah normal
  } else if (totalAccel > ACCEL_THRESHOLD) {
    statusKesehatan = "Aktif Bergerak";    // Pengguna sedang bergerak
  } else {
    statusKesehatan = "Normal";            // Semua parameter dalam batas normal
    notifBPMTerkirim  = false;             // Reset flag agar notif bisa terkirim lagi
    notifSuhuTerkirim = false;
  }
}


/*
 * updateLEDdanBuzzer()
 * --------------------
 * Mengaktifkan LED merah dan buzzer jika terdeteksi kondisi
 * kesehatan yang kritis (Bradikardia, Takikardia, Demam,
 * atau Hipotermia).
 *
 * Pola buzzer: 3x bip pendek (150ms nyala, 100ms mati)
 * agar mudah dibedakan dari suara lain di lingkungan sekitar.
 *
 * LED merah menyala solid (terus menerus) selama kondisi abnormal.
 */
void updateLEDdanBuzzer() {
  bool kondisiKritis = (
    statusKesehatan == "Bradikardia" ||
    statusKesehatan == "Takikardia"  ||
    statusKesehatan == "Demam"       ||
    statusKesehatan == "Hipotermia"
  );

  if (kondisiKritis) {
    digitalWrite(PIN_LED_MERAH, HIGH); // LED menyala
    // Buzzer berbunyi 3x bip
    for (int i = 0; i < 3; i++) {
      digitalWrite(PIN_BUZZER, HIGH);
      delay(150);
      digitalWrite(PIN_BUZZER, LOW);
      delay(100);
    }
  } else {
    digitalWrite(PIN_LED_MERAH, LOW); // LED mati
    digitalWrite(PIN_BUZZER,    LOW); // Buzzer mati
  }
}


